{
  "manifest_version": 3,
  "name": "Chzzk Cheese History (Firefox Fork)",
  "version": "1.1.1",
  "description": "치지직 치즈 후원 및 구독 선물 내역을 연도별/월별 통계로 보여주는 Firefox용 확장 프로그램",
  "browser_specific_settings": {
    "gecko": {
      "id": "chzzk-cheese-history-forked@browser-extensions",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://chzzk.naver.com/*",
    "https://game.naver.com/*",
    "https://api.chzzk.naver.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "치지직 치즈 후원 내역"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "css/chzzkCheeseHistory.css",
        "images/*",
        "js/cheeseHistory.js",
        "js/subscriptionHistory.js",
        "js/util.js",
        "libs/chart.umd.js"
      ],
      "matches": [
        "https://chzzk.naver.com/*",
        "https://game.naver.com/*"
      ]
    }
  ]
}
